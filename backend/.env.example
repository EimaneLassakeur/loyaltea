# ==============================================================================
# Loyaltea Backend — Environment Variables (.env.example)
# Deploying on Render: Set these under Dashboard > Environment > Environment Variables
# ==============================================================================

# Server port (Render automatically sets PORT, defaults to 3000 if unset)
PORT=3000

# Runtime environment (use 'production' on Render)
NODE_ENV=production

# Frontend Origin for CORS security (your Vercel app URL, must use HTTPS in production, no trailing slash)
# Example: https://loyaltea.vercel.app
FRONTEND_ORIGIN=https://your-loyaltea.vercel.app

# Optional OAuth redirect target if Supabase auth redirects through backend
AUTH_REDIRECT_URL=https://your-loyaltea.vercel.app/auth/callback

# Supabase Project Configuration (found in Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection String (Session Pooler recommended for serverless/cloud hosting)
# Found in Supabase Dashboard > Connect > Session pooler (Port 5432).
# IMPORTANT: Do NOT append ?sslmode=... or other SSL query parameters here; the backend enforces TLS internally.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host.pooler.supabase.com:5432/postgres

# Supabase SSL CA Certificate:
# Provide either DATABASE_SSL_CA_B64 (base64 string of the CA certificate) OR DATABASE_SSL_CA (raw pem).
# Download from Supabase Dashboard > Project Settings > Database > SSL Configuration > Download CA certificate.
DATABASE_SSL_CA_B64=your-supabase-ca-certificate-base64-string

# Strict SSL Certificate Validation (must be 'true' in production)
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Public signup toggle (matches frontend policy)
PUBLIC_SIGNUP_ENABLED=true
