PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Copy the Session Pooler URI from Supabase Dashboard > Connect > Session pooler.
# Do not append sslmode, sslrootcert, sslcert, or sslkey; the backend owns TLS settings.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@[SESSION-POOLER-HOST]:5432/postgres
# Base64-encoded contents of the Supabase Database Settings > SSL Configuration CA certificate.
DATABASE_SSL_CA_B64=replace-with-supabase-ca-certificate-base64
DATABASE_SSL_REJECT_UNAUTHORIZED=true
NODE_ENV=development
PUBLIC_SIGNUP_ENABLED=false
