# ==============================================================================
# Loyaltea Frontend — Environment Variables (.env.example)
# Deploying on Vercel: Set these under Project Settings > Environment Variables
# ==============================================================================

# Backend API base URL (your Render service URL, must use HTTPS in production)
# Example: https://loyaltea-api.onrender.com
VITE_API_URL=https://your-backend-api.onrender.com

# Canonical public frontend domain used to generate customer QR codes and shareable links
# Must be HTTPS in production (no trailing slash)
# Example: https://loyaltea.vercel.app
VITE_PUBLIC_APP_URL=https://your-loyaltea.vercel.app

# Public customer self-registration toggle on join screens
# Set to 'true' to allow customers scanning the QR code to create a new account on the spot
# Set to 'false' if customer accounts are invitation/manager-only
VITE_PUBLIC_SIGNUP_ENABLED=true
